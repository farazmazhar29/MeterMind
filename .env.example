# Copy to .env before running anything:  cp .env.example .env
# docker-compose.yml and the Python code both read this same file,
# so there is exactly one place to change a credential.

# --- InfluxDB 2.7 -----------------------------------------------------------
INFLUX_ADMIN_USER=metermind
INFLUX_ADMIN_PASSWORD=changeme-influx
# Any non-empty string works for local dev. Regenerate before exposing anything.
INFLUX_TOKEN=local-dev-token-not-a-secret
INFLUX_ORG=metermind
INFLUX_BUCKET=energy
# Host-side URL. Inside the app container this becomes http://influxdb:8086
INFLUX_URL=http://localhost:8086

# --- Postgres + pgvector ----------------------------------------------------
POSTGRES_USER=metermind
POSTGRES_PASSWORD=changeme-postgres
POSTGRES_DB=metermind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Dataset build ----------------------------------------------------------
# Fixed seed: the synthetic dataset and its anomaly manifest must be
# byte-for-byte reproducible, otherwise the eval gold answers drift.
METERMIND_SEED=20260814
# Sampling interval of the synthetic site meters, in minutes.
# 15 mirrors real German industrial submetering. 60 is a cheaper toggle.
METERMIND_INTERVAL_MINUTES=15
# How much history to generate for the synthetic sites.
METERMIND_HISTORY_DAYS=548

# --- Week 2+ (not needed for the Week 1 data pipeline) ----------------------
ANTHROPIC_API_KEY=
